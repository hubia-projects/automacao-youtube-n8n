{
  "id": "SWfoFJ3aNt2nJboC",
  "name": "Workflow 3 — Render and YouTube Preparation",
  "active": true,
  "nodes": [
    {
      "id": "start_workflow",
      "name": "Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [220, 220],
      "parameters": {}
    },
    {
      "id": "render_video",
      "name": "Render Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 220],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/api/videos/render",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ video_id: $json.video_id, mock_mode: $env.MOCK_MODE === 'true' }) }}"
      }
    },
    {
      "id": "validate_render_sync",
      "name": "Validate Render Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 220],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/api/videos/render/validate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ video_id: $json.video_id, mock_mode: $env.MOCK_MODE === 'true' }) }}"
      }
    },
    {
      "id": "if_render_ok",
      "name": "If Render OK",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [940, 220],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.is_publishable && $json.hard_boundary_status === 'pass' && Number($json.max_visual_lag_sec || 99) <= Number($env.HARD_BOUNDARY_MAX_LAG_SEC || 0.5)}}",
              "operation": "isTrue"
            }
          ]
        }
      }
    },
    {
      "id": "fix_render_sync",
      "name": "Fix Render Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1180, 320],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/api/videos/render/fix-sync",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ video_id: $json.video_id, mock_mode: $env.MOCK_MODE === 'true' }) }}"
      }
    },
    {
      "id": "validate_render_sync_after_fix",
      "name": "Validate Render Sync After Fix",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1420, 320],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/api/videos/render/validate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ video_id: $json.video_id, mock_mode: $env.MOCK_MODE === 'true' }) }}"
      }
    },
    {
      "id": "if_render_ok_after_fix",
      "name": "If Render OK After Fix",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1660, 320],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.is_publishable && $json.hard_boundary_status === 'pass' && Number($json.max_visual_lag_sec || 99) <= Number($env.HARD_BOUNDARY_MAX_LAG_SEC || 0.5)}}",
              "operation": "isTrue"
            }
          ]
        }
      }
    },
    {
      "id": "generate_metadata",
      "name": "Generate Metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1180, 140],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/api/videos/metadata/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ video_id: $json.video_id, mock_mode: $env.MOCK_MODE === 'true' }) }}"
      }
    },
    {
      "id": "generate_metadata_with_warning",
      "name": "Mark Needs Manual Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1900, 400],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/api/videos/review/mark-manual-review",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ video_id: $json.video_id, note: ($json.issues || []).slice(0, 4).map(issue => issue.message || issue.type).filter(Boolean).join('; '), source: 'workflow3_post_fix_validation', mock_mode: $env.MOCK_MODE === 'true' }) }}"
      }
    },
    {
      "id": "final_approval_webhook",
      "name": "Final Approval Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "webhookId": "yt-w3-final-approval",
      "position": [1460, 140],
      "parameters": {
        "path": "final-approval",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "save_approval",
      "name": "Save Approval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1700, 140],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/api/videos/final/approve",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ video_id: $json.body?.video_id || $json.query?.video_id, approved: String($json.body?.approved ?? $json.query?.approved).toLowerCase() === 'true', note: $json.body?.note || $json.query?.note || '', mock_mode: $env.MOCK_MODE === 'true' }) }}"
      }
    },
    {
      "id": "if_approved",
      "name": "If Approved",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1940, 140],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.approved}}",
              "operation": "isTrue"
            }
          ]
        }
      }
    },
    {
      "id": "youtube_upload",
      "name": "Upload to YouTube",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2180, 80],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/api/videos/youtube/upload",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ video_id: $json.video_id, privacy_status: 'private', mock_mode: $env.MOCK_MODE === 'true' }) }}"
      }
    },
    {
      "id": "regenerate_review",
      "name": "Regenerate Review Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2180, 200],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/api/videos/review/regenerate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ video_id: $json.video_id, note: $json.note || '', mock_mode: $env.MOCK_MODE === 'true' }) }}"
      }
    }
  ],
  "connections": {
    "Start": { "main": [[{ "node": "Render Video", "type": "main", "index": 0 }]] },
    "Render Video": { "main": [[{ "node": "Validate Render Sync", "type": "main", "index": 0 }]] },
    "Validate Render Sync": { "main": [[{ "node": "If Render OK", "type": "main", "index": 0 }]] },
    "If Render OK": {
      "main": [
        [{ "node": "Generate Metadata", "type": "main", "index": 0 }],
        [{ "node": "Fix Render Sync", "type": "main", "index": 0 }]
      ]
    },
    "Fix Render Sync": { "main": [[{ "node": "Validate Render Sync After Fix", "type": "main", "index": 0 }]] },
    "Validate Render Sync After Fix": { "main": [[{ "node": "If Render OK After Fix", "type": "main", "index": 0 }]] },
    "If Render OK After Fix": {
      "main": [
        [{ "node": "Generate Metadata", "type": "main", "index": 0 }],
        [{ "node": "Mark Needs Manual Review", "type": "main", "index": 0 }]
      ]
    },
    "Generate Metadata": { "main": [[{ "node": "Final Approval Webhook", "type": "main", "index": 0 }]] },
    "Final Approval Webhook": { "main": [[{ "node": "Save Approval", "type": "main", "index": 0 }]] },
    "Save Approval": { "main": [[{ "node": "If Approved", "type": "main", "index": 0 }]] },
    "If Approved": {
      "main": [
        [{ "node": "Upload to YouTube", "type": "main", "index": 0 }],
        [{ "node": "Regenerate Review Draft", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
