{
  "name": "Workflow 1 — Weekly Topic + Script",
  "active": true,
  "nodes": [
    {
      "id": "manual_trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [220, 360],
      "parameters": {}
    },
    {
      "id": "schedule_trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [220, 120],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "generate_ideas",
      "name": "Generate Ideas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 200],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/api/videos/ideas/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ count: 3, mock_mode: $env.MOCK_MODE === 'true' }) }}"
      }
    },
    {
      "id": "idea_approval_webhook",
      "name": "Idea Approval Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "webhookId": "yt-w1-idea-approval",
      "position": [760, 360],
      "parameters": {
        "path": "idea-approval",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "approve_idea",
      "name": "Approve Idea",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1020, 200],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/api/videos/ideas/approve",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ video_id: $json.body?.video_id || $json.query?.video_id, idea_number: Number($json.body?.idea_number || $json.query?.idea_number), mock_mode: $env.MOCK_MODE === 'true' }) }}"
      }
    },
    {
      "id": "generate_script",
      "name": "Generate Script",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1280, 200],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/api/videos/script/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ video_id: $json.video_id || $json.body?.video_id || $json.query?.video_id, mock_mode: $env.MOCK_MODE === 'true' }) }}"
      }
    },
    {
      "id": "call_workflow2",
      "name": "Call Workflow 2",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [1540, 200],
      "parameters": {
        "workflowId": "YiezxhzyVQT3XJuz",
        "mode": "each",
        "input": "json",
        "jsonData": "={{$json.handoff_payload_workflow_2}}"
      }
    }
  ],
  "connections": {
    "Manual Trigger": { "main": [[{ "node": "Generate Ideas", "type": "main", "index": 0 }]] },
    "Schedule Trigger": { "main": [[{ "node": "Generate Ideas", "type": "main", "index": 0 }]] },
    "Idea Approval Webhook": { "main": [[{ "node": "Approve Idea", "type": "main", "index": 0 }]] },
    "Approve Idea": { "main": [[{ "node": "Generate Script", "type": "main", "index": 0 }]] },
    "Generate Script": { "main": [[{ "node": "Call Workflow 2", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
