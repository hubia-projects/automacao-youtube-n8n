{
  "id": "YiezxhzyVQT3XJuz",
  "name": "Workflow 2 — Audio, Captions and Assets",
  "active": true,
  "nodes": [
    {
      "id": "start_workflow",
      "name": "Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [220, 200],
      "parameters": {}
    },
    {
      "id": "generate_audio",
      "name": "Generate Audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 200],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/api/videos/audio/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ video_id: $json.video_id, provider: 'multivozes', mock_mode: $env.MOCK_MODE === 'true' }) }}"
      }
    },
    {
      "id": "analyze_audio_intelligence",
      "name": "Analyze Audio Intelligence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 200],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/api/videos/audio/intelligence",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ video_id: $json.video_id, mock_mode: $env.MOCK_MODE === 'true' }) }}"
      }
    },
    {
      "id": "generate_captions",
      "name": "Generate Captions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [820, 200],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/api/videos/captions/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ video_id: $json.video_id, mock_mode: $env.MOCK_MODE === 'true' }) }}"
      }
    },
    {
      "id": "search_assets",
      "name": "Search Assets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 200],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/api/videos/assets/search",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ video_id: $json.video_id, mock_mode: $env.MOCK_MODE === 'true' }) }}"
      }
    },
    {
      "id": "if_assets_ready",
      "name": "If Assets Ready",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1140, 200],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{!$json.missing_assets}}",
              "operation": "isTrue"
            }
          ]
        }
      }
    },
    {
      "id": "call_workflow3",
      "name": "Call Workflow 3",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [1260, 200],
      "parameters": {
        "workflowId": "SWfoFJ3aNt2nJboC",
        "mode": "each",
        "input": "json",
        "jsonData": "={{$json.handoff_payload_workflow_3}}"
      }
    },
    {
      "id": "mark_manual_review_missing_assets",
      "name": "Mark Needs Manual Review Missing Assets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1380, 320],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_BASE_URL}}/api/videos/review/mark-manual-review",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ video_id: $json.video_id, note: $json.blocking_scene_indexes?.length ? `Assets insuficientes para render. Cenas bloqueadas: ${$json.blocking_scene_indexes.join(', ')}.` : 'Assets insuficientes para render.', source: 'workflow2_missing_assets', mock_mode: $env.MOCK_MODE === 'true' }) }}"
      }
    }
  ],
  "connections": {
    "Start": { "main": [[{ "node": "Generate Audio", "type": "main", "index": 0 }]] },
    "Generate Audio": { "main": [[{ "node": "Analyze Audio Intelligence", "type": "main", "index": 0 }]] },
    "Analyze Audio Intelligence": { "main": [[{ "node": "Generate Captions", "type": "main", "index": 0 }]] },
    "Generate Captions": { "main": [[{ "node": "Search Assets", "type": "main", "index": 0 }]] },
    "Search Assets": { "main": [[{ "node": "If Assets Ready", "type": "main", "index": 0 }]] },
    "If Assets Ready": {
      "main": [
        [{ "node": "Call Workflow 3", "type": "main", "index": 0 }],
        [{ "node": "Mark Needs Manual Review Missing Assets", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
