APP_PORT=8080
APP_HOST_PORT=8081
N8N_HOST_PORT=5679
MOCK_MODE=false
LOCAL_TEST_MODE=false
LOCAL_TEST_DISABLE_OPENAI=true
LOCAL_TEST_DISABLE_GEMINI=true
LOCAL_TEST_DISABLE_YOUTUBE=true
EXTERNAL_API_CIRCUIT_BREAKER_ENABLED=false
EXTERNAL_API_MAX_CALLS_TOTAL=-1
EXTERNAL_API_MAX_CALLS_OPENAI=-1
EXTERNAL_API_MAX_CALLS_GEMINI=-1
EXTERNAL_API_MAX_CALLS_YOUTUBE=-1
ALLOW_PLACEHOLDER_ASSETS=false
OUTPUT_ROOT=/app/pipeline/output
TEST_REPORTS_ROOT=/app/pipeline/output/test_reports

# OpenAI (ideas/script/transcription + TTS fallback)
OPENAI_API_KEY=
OPENAI_REQUEST_TIMEOUT_MS=45000

# Multivozes BR Engine (primary TTS - OpenAI compatible)
MULTIVOZES_BR_ENGINE=
MULTIVOZES_BR_BASE_URL=http://host.docker.internal:5050/v1
MULTIVOZES_DEFAULT_VOICE=alloy
MULTIVOZES_CHUNK_MAX_CHARS=420
MULTIVOZES_CHUNK_RETRIES=3
# When running Node outside Docker, these values can auto-start the service from this repo compose.
MULTIVOZES_AUTO_START=false
MULTIVOZES_PROJECT_PATH=pipeline
MULTIVOZES_DOCKER_SERVICE=multivozes
MULTIVOZES_START_TIMEOUT_MS=30000

# Gemini (optional smoke/preflight connector)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_VISION_ENABLED=true
GEMINI_VISION_MODEL_LITE=gemini-2.5-flash-lite
GEMINI_VISION_MODEL_FULL=gemini-2.5-flash
GEMINI_VISION_FALLBACK_MODELS=gemini-2.0-flash
GEMINI_VISION_TIMEOUT_MS=45000
GEMINI_VISION_MAX_RETRIES=2
GEMINI_VISION_RETRY_BASE_MS=1200
GEMINI_VISION_ESCALATION_MIN_CONFIDENCE=0.62
GEMINI_VISION_ESCALATION_MAX_GENERIC_RATIO=0.5

# ElevenLabs (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Stock APIs
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# Telegram approvals
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_INTERVAL_MS=3000
TELEGRAM_VERBOSE_STATUS=true

# Semantic B-roll synchronization
# cost-efficient: fewer visual samples/QA calls; high-quality: denser asset windows and QA sampling
SEMANTIC_SYNC_MODE=cost-efficient
SEMANTIC_SYNC_MAX_LATENCY_SEC=1
SEMANTIC_SYNC_QA_MIN_SCORE=0.78
SEMANTIC_SYNC_QA_SAMPLE_INTERVAL_SEC=2
HARD_BOUNDARY_ENABLED=true
HARD_BOUNDARY_MAX_LAG_SEC=0.5
HARD_BOUNDARY_FORBID_NEUTRAL_FIRST_CLIP=true
HARD_BOUNDARY_REQUIRE_LOCATION=true
HARD_BOUNDARY_REQUIRE_CHAPTER_OVERLAY=true
HARD_BOUNDARY_FAIL_ON_MISS=true
PRE_RENDER_EDITORIAL_FAIL_FAST=true
RUNTIME_DEGRADE_ON_MISSING_ASSETS=true
LOCAL_VIDEO_UNDERSTANDING_ENABLED=false
LOCAL_VIDEO_UNDERSTANDING_MODE=frames
LOCAL_VIDEO_UNDERSTANDING_WINDOW_SECONDS=8
LOCAL_VIDEO_UNDERSTANDING_MAX_WINDOWS=20
LOCAL_VIDEO_UNDERSTANDING_PYTHON=python
LOCAL_VIDEO_UNDERSTANDING_SCRIPT=tools/video-understanding/analyze_video.py
ASSET_SEARCH_RESULTS_PER_QUERY=12
ASSET_CANDIDATE_POOL_PER_SCENE=30
ASSET_DOWNLOAD_TOP_PER_SCENE=6
ASSET_RAW_CANDIDATES_PER_BLOCK=60
ASSET_CHEAP_SHORTLIST_PER_BLOCK=20
ASSET_VISION_FINALISTS_PER_BLOCK=24
ASSET_MAX_REPAIR_ROUNDS_PER_BLOCK=3
ASSET_SCARCITY_RAW_CANDIDATES_PER_BLOCK=120
ASSET_SCARCITY_CHEAP_SHORTLIST_PER_BLOCK=50
ASSET_SCARCITY_VISION_FINALISTS_PER_BLOCK=24
COVERAGE_GATE_MAX_REPAIR_ROUNDS_PER_BLOCK=2
COVERAGE_GATE_ALLOW_PARTIAL=true
EDITORIAL_STRONG_ONLY_PRE_RENDER=true
REPAIR_PLANNER_MAX_LOCAL_ROUNDS=2
CRITICAL_SLOT_MIN_PROVIDER_RELIABILITY=0.45
CRITICAL_SLOT_PREFERRED_PROVIDER_RELIABILITY=0.6
CRITICAL_SLOT_MIN_SEMANTIC_RELEVANCE=0.45
CRITICAL_SLOT_MIN_EDITORIAL_EVIDENCE=0.58
CRITICAL_SLOT_MAX_SEMANTIC_RISK=0.55
ASSET_PROVIDER_MAX_PER_BLOCK=3
ASSET_PROVIDER_MAX_PER_BLOCK_RELAXED=8
LOCAL_CURATED_ASSET_INDEX=
LOCAL_CURATED_ASSETS_DIR=
USE_CLIP_LIBRARY=false
USE_SCENE_INDEX=false
CLIP_LIBRARY_POLICY_VERSION=v1
CLIP_LIBRARY_DB_PATH=
SCENE_INDEX_DB_PATH=
CLIP_LIBRARY_ROOT_DIR=
CLIP_LIBRARY_MAX_SEARCH_RESULTS=24
CLIP_LIBRARY_TARGET_DURATIONS=3,5,15
CLIP_LIBRARY_MAX_MICROCLIPS_PER_WINDOW=8
CLIP_LIBRARY_SHADOW_ENABLED=false
CLIP_LIBRARY_SHADOW_VIDEO_PATH=
CLIP_LIBRARY_SHADOW_REPORT_DIR=
AI_GENERATED_PLACEHOLDER_ENABLED=false
EDITORIAL_LIBRARY_REUSE_COOLDOWN_HOURS=12
MIN_SPECIFIC_ASSETS_PER_SCENE=2
ENABLE_BLOCK_OVERLAYS=true
OUTPUT_WIDTH=1920
OUTPUT_HEIGHT=1080
OUTPUT_FPS=30
VIDEO_BITRATE=6M
MAX_VIDEO_BITRATE=8M

N8N_IDEA_APPROVAL_WEBHOOK_PATH=idea-approval
N8N_FINAL_APPROVAL_WEBHOOK_PATH=final-approval

# Google review publishing (optional: upload review draft to Drive and register on Sheets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
REVIEW_DRIVE_FOLDER_ID=
REVIEW_SPREADSHEET_ID=
REVIEW_SHEET_NAME=Revisoes
REVIEW_DRIVE_PUBLIC=true

# YouTube upload
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_DEFAULT_PRIVACY=private

# Optional n8n webhook handoff (if backend should trigger workflow 2/3 directly)
N8N_WORKFLOW_2_WEBHOOK=
N8N_WORKFLOW_3_WEBHOOK=

# For n8n imported workflows
BACKEND_BASE_URL=http://app:8080
N8N_BASE_URL=http://n8n:5678
